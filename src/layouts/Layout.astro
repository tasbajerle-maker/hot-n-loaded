---
export interface Props {
	title: string;
	description?: string;
	noindex?: boolean; /* ÚJ: Ezzel tiltjuk le az indexelést a jogi oldalakon */
}

const { title, description = "A legjobb kézműves fagyik és burgerek.", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="hu">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- ÚJ: Ha a noindex true, a keresőmotorok békén hagyják ezt az aloldalt -->
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		
		<title>{title}</title>

		<!-- Google Fonts globális betöltése -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono:wght@500;600;700&family=Work+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* CSS RESET */
	* { box-sizing: border-box; margin: 0; padding: 0; }
	html { scroll-behavior: smooth; }

	/* ROOT & GLOBAL STYLES */
	:root {
		--char-900: #1c1410;
		--ember: #ff5a1f;
		--ember-dim: #c2410c;
		--cheese: #ffc94a;
		--cream: #fff6e9;
		--cream-2: #fce9d8;
		--ink: #241812;
		--paper: #f4efe9;
	}

	body { background-color: #e5dfd6; margin: 0; display: flex; justify-content: center; font-family: 'Work Sans', sans-serif; color: var(--ink); }

	.app-wrapper {
		width: 100%; max-width: 480px; background: var(--paper); min-height: 100vh;
		position: relative; overflow-x: hidden; box-shadow: 0 0 0 transparent;
	}

	@media (min-width: 540px) {
		.app-wrapper {
			margin: 4vh 0; min-height: 92vh; border-radius: 40px;
			box-shadow: 0 32px 64px -12px rgba(0,0,0,0.2), 0 0 0 10px var(--char-900), inset 0 0 0 4px rgba(255,255,255,0.2);
			border: 4px solid #332822; overflow: hidden;
		}
	}
</style>