---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import LocationCard from '../components/LocationCard.astro';
---

<Layout title="Kapcsolat | Nyaloda">
  <div class="app-wrapper">
    <TopBar cartCount={2} />
    
    <main class="page">
      <header class="page-header">
        <a href="/" class="minimal-back">← Vissza</a>
        <h1>Kapcsolat</h1>
        <p>Látogass el üzleteink valamelyikébe, vagy vedd fel velünk a kapcsolatot online!</p>
      </header>

      <section class="content-section">
        <LocationCard 
          title="📍 1. Üzlet (Újpest-Központ)" 
          address="1042 Budapest, Király u. 25." 
          hours="11:00 - 22:00" 
          tags={['🍔 Hot & Loaded', '🍦 Nyaloda']} 
        />

        <LocationCard 
          title="📍 2. Üzlet (Káposztásmegyer)" 
          address="1041 Budapest, Óceánárok utca 29." 
          hours="11:00 - 22:00" 
          tags={['🍔 Hot & Loaded', '🍦 Nyaloda']} 
        />

        <LocationCard 
          title="📍 3. Üzlet (Újpalota)" 
          address="1157 Budapest, Nyírpalota út 52." 
          hours="11:00 - 22:00" 
          tags={['🍔 Hot & Loaded', '🍦 Nyaloda']} 
        />
        
        <div class="contact-info-card">
            <h3>Elérhetőségek</h3>
            <p>✉️ <strong>Email:</strong> <a href="mailto:hokuszpokuszicekft@gmail.com">hokuszpokuszicekft@gmail.com</a></p>
            <p>📱 <strong>Facebook:</strong> Hot & Loaded / Nyaloda</p>
            <p>📸 <strong>Instagram:</strong> <a href="https://instagram.com/nyalodafagyi" target="_blank">@nyalodafagyi</a></p>
            <p>🎵 <strong>TikTok:</strong> <a href="https://tiktok.com/@nyaloda" target="_blank">@nyaloda</a></p>
            <br>
            <a href="https://enfagyi-app-122a0.web.app/drive" class="order-btn" target="_blank">Rendelés és Kiszállítás 🚀</a>
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page-header { padding: 24px 16px 16px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  
  .minimal-back { 
      text-decoration: none; color: var(--char-900); font-weight: 600; 
      font-family: 'IBM Plex Mono', monospace; font-size: 12px; text-transform: uppercase; 
      background: rgba(0, 0, 0, 0.05); padding: 6px 12px; border-radius: 8px; transition: background 0.2s; 
  }
  .minimal-back:active { background: rgba(0, 0, 0, 0.1); }
  
  .page-header h1 { font-family: 'Anton', sans-serif; font-size: 32px; text-transform: uppercase; color: var(--char-900); margin: 0; line-height: 1.1; }
  .page-header p { font-size: 14px; opacity: 0.7; margin: 0; line-height: 1.4; }

  .content-section { padding: 16px; display: flex; flex-direction: column; gap: 16px; }

  .contact-info-card {
      background: #fff;
      padding: 20px;
      border-radius: 20px;
      border: 1px solid rgba(0,0,0,0.04);
      box-shadow: 0 6px 16px rgba(0,0,0,0.03);
  }

  .contact-info-card h3 {
      font-family: 'Anton', sans-serif;
      font-size: 18px;
      color: var(--char-900);
      margin: 0 0 12px 0;
      text-transform: uppercase;
      font-weight: 400;
  }

  .contact-info-card p {
      font-size: 14px;
      margin: 0 0 8px 0;
      color: var(--ink);
  }

  .contact-info-card a {
      color: var(--ember);
      text-decoration: none;
      font-weight: 600;
  }

  .contact-info-card a:hover {
      text-decoration: underline;
  }

  .order-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--char-900);
      color: var(--cream) !important;
      padding: 12px;
      border-radius: 12px;
      font-family: 'Anton', sans-serif;
      font-size: 16px;
      text-transform: uppercase;
      text-decoration: none !important;
      letter-spacing: 0.05em;
      transition: transform 0.2s, background-color 0.2s;
  }

  .order-btn:active {
      transform: scale(0.98);
      background: var(--ember);
  }
</style>