---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
---

<Layout title="Impresszum | Nyaloda" noindex={true}>
	<div class="app-wrapper">
		<TopBar cartCount={0} />
		
		<main class="page">
			<header class="page-header">
				<a href="/" class="minimal-back">← Vissza</a>
				<h1>Impresszum</h1>
			</header>

			<section class="legal-content">
				<div class="legal-card">
					<h2>Szolgáltató adatai</h2>
					<p><strong>Cégnév:</strong> Hókuszpókusz Ice Kft.</p>
					<p><strong>Székhely:</strong> 1157 Budapest, Zsókavár utca 62.</p>
					<p><strong>Adószám:</strong> 23314287-2-42</p>
					
					<p><strong>Képviselők:</strong> Szabó Beatrix, Bajerle Tas</p>
					
					<h2>Elérhetőségek</h2>
					<p><strong>E-mail cím:</strong> <a href="mailto:hokuszpokuszicekft@gmail.com">hokuszpokuszicekft@gmail.com</a></p>
					<p><strong>Weboldal:</strong> nyaloda.hu</p>

					<h2>Tárhelyszolgáltató</h2>
					<p><strong>Név:</strong> Netlify, Inc.</p>
					<p><strong>Székhely:</strong> 44 Montgomery Street, Suite 300, San Francisco, California 94104, USA</p>
					<p><strong>Web:</strong> <a href="https://www.netlify.com" target="_blank">netlify.com</a></p>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page-header { padding: 24px 16px 16px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
	.minimal-back { 
		text-decoration: none; color: var(--char-900); font-weight: 600; 
		font-family: 'IBM Plex Mono', monospace; font-size: 12px; text-transform: uppercase; 
		background: rgba(0, 0, 0, 0.05); padding: 6px 12px; border-radius: 8px; transition: background 0.2s; 
	}
	.minimal-back:active { background: rgba(0, 0, 0, 0.1); }
	.page-header h1 { font-family: 'Anton', sans-serif; font-size: 32px; text-transform: uppercase; color: var(--char-900); margin: 0; line-height: 1.1; }
	
	.legal-content { padding: 0 16px 40px; }
	.legal-card {
		background: #fff; padding: 24px; border-radius: 20px;
		border: 1px solid rgba(0,0,0,0.04); box-shadow: 0 6px 16px rgba(0,0,0,0.03); color: var(--ink);
	}
	
	.legal-card h2 { font-family: 'Anton', sans-serif; font-size: 20px; text-transform: uppercase; margin: 24px 0 12px; color: var(--char-900); font-weight: 400;}
	.legal-card h2:first-child { margin-top: 0; }
	.legal-card p { font-size: 14px; line-height: 1.6; margin: 0 0 8px 0; }
	.legal-card a { color: var(--ember); text-decoration: none; font-weight: 600; }
</style>