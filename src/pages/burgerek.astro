---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import InteractiveMenu from '../components/InteractiveMenu';
import LocalGuide from '../components/LocalGuide.astro';
import type { MenuItem } from '../components/InteractiveMenu';

const burgerData: MenuItem[] = [
  {
    id: 'b-sajt', name: 'Sajtburger', category: 'Burgerek', price: 1800,
    description: 'Marhahús, sajt, hagyma, házi burger szósz, uborka.',
    nutrition: { calories: 510, protein: 28, carbs: 38, fat: 26 },
    allergens: ['Glutén', 'Tej', 'Tojás', 'Mustár'], emoji: '🍔', imageUrl: '/images/menu/b-sajt.webp'
  },
  {
    id: 'b-tavaszi', name: 'Tavaszi Burger', category: 'Burgerek', price: 2000,
    description: 'Marhahús, jégsaláta, burger szósz, cheddar, paradicsom.',
    nutrition: { calories: 520, protein: 28, carbs: 40, fat: 26 },
    allergens: ['Glutén', 'Tej', 'Tojás', 'Mustár'], emoji: '🥬', imageUrl: '/images/menu/b-tavaszi.webp'
  },
  {
    id: 'b-rio', name: 'Rio Burger', category: 'Burgerek', price: 2000,
    description: 'Marhahúspogácsa, sajt, jalapeno, pirított hagyma, házi burgerszósz.',
    nutrition: { calories: 580, protein: 31, carbs: 42, fat: 32 },
    allergens: ['Glutén', 'Tej', 'Tojás', 'Mustár'], emoji: '🌶️', imageUrl: '/images/menu/b-rio.webp'
  },
  {
    id: 'b-dupla', name: 'Dupla Burger', category: 'Burgerek', price: 2900,
    description: 'Dupla marhahús, dupla cheddar sajt, házi burgerszósz, paradicsom, jégsaláta.',
    nutrition: { calories: 820, protein: 52, carbs: 42, fat: 48 },
    allergens: ['Glutén', 'Tej', 'Tojás', 'Mustár'], emoji: '🍔', imageUrl: '/images/menu/b-dupla.webp'
  },
  {
    id: 'b-tal', name: 'Burger Tál', category: 'Burgerek', price: 4300,
    description: 'Dupla marhahús, dupla sajt, sültkrumpli, saláta, paradicsom, hagyma, bacon, pirított hagyma, házi burgerszósz.',
    allergens: ['Glutén', 'Tej', 'Tojás', 'Mustár'], emoji: '🍟', imageUrl: '/images/menu/b-tal.webp'
  },
  {
    id: 't-sajt', name: 'Sajtos Toast', category: 'Burgerek', price: 700,
    description: 'Klasszikus toast, sok sajttal.',
    nutrition: { calories: 320, protein: 14, carbs: 30, fat: 16 },
    allergens: ['Glutén', 'Tej'], emoji: '🥪', imageUrl: '/images/menu/t-sajt.webp'
  },
  {
    id: 't-bacon', name: 'Sajtos Baconös Toast', category: 'Burgerek', price: 950,
    description: 'Sajt és ropogós bacon egy finom toastban.',
    nutrition: { calories: 410, protein: 18, carbs: 30, fat: 24 },
    allergens: ['Glutén', 'Tej'], emoji: '🥓', imageUrl: '/images/menu/t-bacon.webp'
  }
];

const guide = {
  heading: 'Smash burger Újpesten – friss marhahúsból',
  intro: [
    'A Hot & Loaded az újpesti Király utcában süti a smash burgereit: friss marhahúsból formázott pogácsa, forró lapon rányomva, hogy kívül ropogós, belül szaftos maradjon.',
    'A klasszikus sajtburgertől a dupla húsos, dupla cheddaros Dupla Burgerig és a sültkrumplis Burger Tálig mindent megtalálsz, mellé toastot, köreteket és mártogatósokat.',
  ],
  sectionName: 'Burgerek és toastok',
  items: burgerData.map((i) => ({ name: i.name, price: i.price ?? 0, description: i.description })),
  howToOrder: [
    'Helyben, a Király utca 25-ben – benti asztalok és terasz is van.',
    'Elvitelre: rendeld meg előre a webappban, és vedd át a pultnál.',
    'Drive-in: rendelj a webappban, és kivisszük a kocsihoz.',
    'Házhozszállítással: a webappban vagy a foodorán.',
  ],
  faq: [
    { q: 'Hol van jó smash burger Újpesten?', a: 'A Hot & Loaded üzletében, 1042 Budapest, Király utca 25. Friss marhahúsból készítjük, helyben, elvitelre, drive-innel és házhozszállítással is.' },
    { q: 'Mennyibe kerül egy burger?', a: 'A Sajtburger 1800 Ft, a Tavaszi és a Rio Burger 2000 Ft, a Dupla Burger 2900 Ft, a Burger Tál 4300 Ft.' },
    { q: 'Rendelhetek házhozszállítással?', a: 'Igen, a webappban és a foodorán is.' },
    { q: 'Van drive-in?', a: 'Igen: rendelj a webappban drive-in átvétellel, és kivisszük a kocsihoz.' },
    { q: 'Hová navigáljak autóval?', a: 'A navigációba a Virág utca 41-et írd be, mert a Király utca 25-öt a térképek pár száz méterrel odébb jelölik.' },
  ],
};
---

<Layout title="Smash burger Újpesten – friss marhahúsból | Hot & Loaded" description="Smash burgerek friss marhahúsból Újpesten, a Király utca 25-ben: Sajtburger, Rio, Dupla Burger, Burger Tál. Helyben, elvitelre, drive-innel és házhozszállítással." ogImage="/images/menu/b-dupla-og.jpg">
  <div class="app-wrapper fixed-app">
    <TopBar />

    <main class="page fixed-page">
      <a href="/" class="floating-back" aria-label="Vissza a főoldalra">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </a>

      <section class="menu-section">
        <InteractiveMenu client:load items={burgerData} />
      </section>

      <LocalGuide {...guide} pageUrl="https://nyaloda.com/burgerek/" />
    </main>
  </div>
</Layout>

<style>
  /* A menü egy képernyőnyi magas (a felső sáv alatt), alatta görgetve jön a leírás. */
  .fixed-app {
    display: flex;
    flex-direction: column;
  }

  .fixed-page {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Apple iPhone "Safe Area" támogatása alul */
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .floating-back {
    position: absolute;
    top: 16px; 
    left: 20px;
    z-index: 100;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--char-900);
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s;
  }
  .floating-back svg {
    width: 20px;
    height: 20px;
    transform: translateX(-1px);
  }
  .floating-back:active { 
    transform: scale(0.9); 
    background: rgba(255, 255, 255, 0.85); 
  }

  .menu-section { 
    height: calc(100dvh - 57px);
    display: flex; 
    flex-direction: column; 
    /* Itt megemeltük az alsó paddingot 32px-re, plusz rászámoljuk az iPhone safe area-t! */
    padding: 0 8px calc(32px + env(safe-area-inset-bottom, 0px));
    overflow: hidden; 
  }
  @media (min-width: 540px) {
    .menu-section { height: calc(92vh - 57px); }
  }
</style>